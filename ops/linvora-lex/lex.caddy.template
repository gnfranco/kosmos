# Pilot separated from adv.linvora.com.br and from the Linvora SaaS app.
# bcrypt hash is generated from the random pilot password by install-services.sh
lex.linvora.com.br {
    encode zstd gzip
    basicauth {
        piloto @BASIC_AUTH_HASH@
    }
    @static path /static/*
    handle @static {
        root * /srv/kosmos-lex/app
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:18085
    }
}
