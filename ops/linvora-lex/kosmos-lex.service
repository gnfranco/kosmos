[Unit]
Description=Kosmos Lex (Linvora) Django web - homologacao isolada
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=kosmoslex
Group=kosmoslex
WorkingDirectory=/srv/kosmos-lex/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/kosmos-lex/app/.venv/bin/gunicorn --bind 127.0.0.1:18085 --workers 2 --timeout 45 --access-logfile - --error-logfile - config.wsgi:application
Restart=on-failure
RestartSec=6
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
MemoryMax=900M
TasksMax=160

[Install]
WantedBy=multi-user.target
